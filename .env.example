# ─────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha seus valores reais
# NUNCA envie o .env para o git!
# ─────────────────────────────────────────────────────────

# Token do Bot do Discord
# Obtido em: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=seu_token_aqui

# Chave da API do Google Gemini (opcional — para o modo RPG)
# Obtida em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_gemini_aqui
